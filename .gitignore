# Git-derived site dates, regenerated by scripts/generate-page-dates.sh at
# deploy time (msge-no ADR 0004 / hetzner-server ADR 0015 pattern). Never
# commit — it would go stale and diverge from the checkout's actual git history.
page-dates.json

# This image's git identity, regenerated by scripts/generate-build-info.sh on the
# checkout at deploy time, BEFORE the image build (hetzner-server ADR 0022).
# Never commit — a committed copy would name a commit the running image doesn't
# actually carry, which is exactly the drift /version exists to expose.
build-info.json
